USE world;

#1) Muestra todos los datos de la tabla city.
SELECT *
FROM city;

#2) Muestra el "name", "continente" y "region" de la tabla country.
SELECT Name, Continent, Region
FROM country;

#3) Muestra los nombres de los países y su "population" ordenados por su "LifeExpectancy" de mayor a menor.
SELECT Name, Population
FROM country
ORDER BY LifeExpectancy DESC;

#4) Muestra el top10 de los países de la consulta anterior.
SELECT Name, Population
FROM country
ORDER BY LifeExpectancy DESC
LIMIT 10;

#5) Muestra cuáles son las "GovernmentForm" únicas que hay en la tabla country.
SELECT DISTINCT GovernmentForm
FROM country
ORDER BY GovernmentForm;

#6) Muestra todos los lenguajes que se hablan en el mundo.
SELECT DISTINCT Language
FROM countrylanguage
ORDER BY Language;
